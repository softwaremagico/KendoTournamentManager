COMPOSE_PROJECT_NAME=kendo_tournament
machine_domain=<<machine-domain>>
email=myemail@domain.com

#Backend
# Generate with: openssl rand -hex 32
jwt_secret=
# Exact frontend origin(s) for CORS; leave empty for same-origin only.
server_cors_domains=
# Forwarded headers are not trusted by default. Use "framework" only behind a
# proxy that overwrites (not appends to) X-Forwarded-* headers.
SERVER_FORWARD_HEADERS_STRATEGY=none
# Generate with: htpasswd -nB -C 12 admin
TRAEFIK_BASIC_AUTH_USERS=

#Database
database_name=kendotournament
database_user=myuser
# Generate with: openssl rand -hex 32
database_password=
database_port=3306
# Generate with: openssl rand -hex 32 and keep it stable across restarts.
database_encryption_key=
database_populate_default_data=always