COMPOSE_PROJECT_NAME=kendo_tournament
machine_domain=localhost
email=myemail@domain.com
timezone=Europe/Madrid
release=v3.6.0
version=${version}

#Frontend
frontend_path=/kendo-tournament-frontend
protocol=http
websocket_protocol=http
achievements_enabled=true

#Backend
jwt_expiration=1200000
jwt_guest_expiration=3600000
# Generate with: openssl rand -hex 32
jwt_secret=
jwt_ip_check=false
# Exact frontend origin(s) for CORS; leave empty for same-origin only.
server_cors_domains=
# Generate with: htpasswd -nB -C 12 admin
TRAEFIK_BASIC_AUTH_USERS=

#Database
database_type=postgresql
database_name=postgres
database_user=myuser
# Generate with: openssl rand -hex 32
database_password=
database_port=5432
# Generate with: openssl rand -hex 32 and keep it stable across restarts.
database_encryption_key=
database_populate_default_data=always

#Options
enable_guest_user=false
enable_tenancy=true
check_new_version_enabled=true



